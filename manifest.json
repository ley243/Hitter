{
  "manifest_version": 3,
  "name": "KIORAxAUTO",
  "version": "2.0.0",
  "description": "KIORAxAUTO - Advanced Checkout Automation",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "offscreen",
    "downloads",
    "clipboardWrite",
    "tabs",
    "webNavigation",
    "alarms",
    "proxy",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "script/background.js"
  },
  "action": {
    "default_title": "KIORAxAUTO"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.stripe.com/*",
        "*://*.stripe.network/*",
        "*://*/c/pay/*"
      ],
      "js": [
        "script/content-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.stripe.com/*",
        "*://*.stripe.network/*",
        "*://*/c/pay/*"
      ],
      "js": [
        "script/content-3ds-relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.stripe.com/*",
        "*://*.stripe.network/*",
        "*://*/c/pay/*"
      ],
      "js": [
        "script/content.js",
        "script/theme-in-page.js",
        "script/content-bincc.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.stripe.com/*",
        "*://*.stripe.network/*",
        "*://checkout.stripe.com/*",
        "*://*/c/pay/*"
      ],
      "js": [
        "script/auto-3ds-cancel.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.stripe.com/*",
        "*://checkout.stripe.com/*",
        "*://*/c/pay/*"
      ],
      "js": [
        "script/gateway-skip.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.hcaptcha.com/*",
        "*://hcaptcha.com/*"
      ],
      "js": [
        "script/hcaptcha.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.stripe.com/*",
        "*://*.stripe.network/*",
        "*://*.google.com/recaptcha/*",
        "*://recaptcha.net/recaptcha/*"
      ],
      "js": [
        "script/recaptcha-audio-solver.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.google.com/recaptcha/*",
        "*://recaptcha.net/recaptcha/*"
      ],
      "js": [
        "script/recaptcha-iframe-solver.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.stripe.com/*",
        "*://*.stripe.network/*"
      ],
      "js": [
        "script/gateway-handlers.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "script/inject.js",
        "script/inject-relay.js",
        "script/storage.js",
        "script/card-gen.js",
        "script/autofill.js",
        "script/captcha-solver.js",
        "script/network-monitor.js",
        "script/gateway-handlers.js",
        "script/gateway-skip.js",
        "styles.css",
        "sounds/hit.wav",
        "icons/icon128.png",
        "safe-test-page.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}